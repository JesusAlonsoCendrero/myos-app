{
  "name": "myos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MyOS - Tu sistema operativo personal: objetivos, tareas, gimnasio, proyectos, viajes y KPIs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "import-exercises": "node --env-file=.env scripts/import-exercises.mjs",
    "check-catalog": "node --env-file=.env scripts/check-catalog.mjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/manrope": "^5.1.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.48.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.474.0",
    "motion": "^12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
