# Copia este archivo a ".env" y pega tus valores de Supabase.
#
# VITE_SUPABASE_URL      -> Settings > Data API > Project URL
# VITE_SUPABASE_ANON_KEY -> Settings > API Keys > Publishable key (empieza por "sb_publishable_")
#                           En proyectos antiguos se llamaba "anon public key".
#
# La publishable key es PUBLICA por diseno: la seguridad la da Row Level Security.
# NUNCA pongas aqui la "secret key" (sb_secret_...) ni la antigua "service_role".

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Entrada automatica (opcional, app de un solo usuario) -------------------
# Con estas dos variables la app entra sola: no hay pantalla de login.
# Deja las dos vacias para volver al login normal con email y contrasena.
# La contrasena debe tener 6 caracteres como minimo (lo exige Supabase).
#
# AVISO: estos valores acaban dentro del JavaScript que descarga el navegador.
# Vale para uso local o en red propia. Con una URL publica, cualquiera que la
# encuentre entraria como tu.
VITE_AUTO_EMAIL=
VITE_AUTO_PASSWORD=

# --- Importador del catalogo de ejercicios (solo Node, nunca el navegador) ---
# Ninguna de estas dos lleva prefijo VITE_ a proposito: asi Vite no puede
# meterlas en el bundle. Solo las lee  npm run import-exercises.
#
# WORKOUTX_API_KEY    -> tu clave de workoutxapp.com
# SUPABASE_SECRET_KEY -> Settings > API Keys > Secret keys (sb_secret_...).
#                        Se salta Row Level Security: tratala como una contrasena.
WORKOUTX_API_KEY=
SUPABASE_SECRET_KEY=
